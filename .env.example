# Copy this file to .env and fill in whichever provider(s) you want to use.
# You only need ONE provider configured to run real (non-demo) analyses —
# demo mode works with none of these set. Model selection happens in the
# app's Settings screen at runtime, not via environment variables.

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=

# --- Azure OpenAI --------------------------------------------------------------
# All three are required together; if only some are set, Azure is skipped.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_ID=
# Optional, defaults to 2024-02-15-preview.
AZURE_OPENAI_API_VERSION=

# --- Claude (Anthropic) --------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Server ---------------------------------------------------------------
# Optional, defaults to 3000.
PORT=
# Optional — set to 1 to force every request into demo mode (no key needed),
# useful for a kiosk/presentation environment. Leave unset for normal use.
DEMO_MODE=
