<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Plaintext credentials checked into source control. -->
    <add name="OrdersDb"
         connectionString="Server=PROD-SQL01;Database=Orders;User Id=sa;Password=P@ssw0rd123;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ApiTimeout" value="30" />
    <add key="PaymentGatewayUrl" value="http://payments.internal.contoso.com/api/charge" />
    <add key="LogPath" value="C:\inetpub\logs\orders\order-service.log" />
    <add key="EnableLegacyMode" value="true" />
  </appSettings>

  <system.web>
    <!-- In-process session state does not survive scale-out / restarts on the cloud. -->
    <sessionState mode="InProc" timeout="20" />
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
  </system.web>
</configuration>
